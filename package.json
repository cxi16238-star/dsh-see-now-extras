{
  "name": "dsh-see-now-extras",
  "version": "0.1.10",
  "description": "给已装好的 dsh-see-now 打补丁：小窗交流绑定会话 / 自定义 1~3 键快捷键开关陪看 / DSH 获焦就停 / 被打断后自动续看 / 顶栏状态与静音。不 fork 官方包，可一键还原。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "see-now",
    "patch"
  ],
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./patch": "./src/patch.js"
  },
  "files": [
    "src",
    "payload",
    "patch.json",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.7"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "Apache-2.0",
  "repository": "git+https://github.com/cxi16238-star/dsh-see-now-extras.git",
  "homepage": "https://github.com/cxi16238-star/dsh-see-now-extras",
  "bugs": {
    "url": "https://github.com/cxi16238-star/dsh-see-now-extras/issues"
  }
}
